# DISABLED: This workflow was causing conflicts with sync-deploy-postgres.yml
# Both workflows were trying to upload GitHub Pages artifacts simultaneously
# when sync-deploy-postgres.yml commits triggered this workflow.
#
# The main sync-deploy-postgres.yml workflow already handles GitHub Pages deployment
# after processing all the data, so this redundant workflow is not needed.
#
# Disabled on August 23, 2025 to fix "Multiple artifacts named 'github-pages'" error

name: Deploy to GitHub Pages (DISABLED)

on:
  # Disabled by commenting out triggers
  # push:
  #   branches: [ main ]
  # workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      
      - name: Setup Pages
        uses: actions/configure-pages@v5
      
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'
      
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
